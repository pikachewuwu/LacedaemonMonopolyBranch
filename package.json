{
  "name": "lacedaemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modulares Lacedaemon-Community-Portal mit Vanilla JS, Express und SQLite/PostgreSQL",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "check": "node scripts/check-project.js",
    "check:leaderboard": "node scripts/check-leaderboard-browser.js",
    "check:games": "node scripts/check-games-browser.js",
    "check:anime": "node scripts/check-anime-browser.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}
