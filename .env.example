# Kopieren nach .env (niemals echte Zugangsdaten committen)
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Standard: SQLite (kein Docker oder DB-Server erforderlich)
DB_CLIENT=sqlite
SQLITE_FILE=./data/lacedaemon.sqlite

# Alternative: DB_CLIENT=postgres und Verbindung unten aktivieren.
# DATABASE_URL=postgresql://postgres:DEIN_PASSWORT@localhost:5432/lacedaemon

# Zugangspasswort für die ganze Seite (Testserver im Internet). Leer = offen.
# SITE_PASSWORD=

# Discord-Login (https://discord.com/developers/applications -> OAuth2).
# Ohne diese Werte läuft Monopoly nur mit Gast-Namen.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Optional: nur Mitglieder dieses Discord-Servers dürfen sich anmelden
# DISCORD_GUILD_ID=
