# Kopieren nach .env (niemals echte Zugangsdaten committen)
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Standard: SQLite (kein Docker oder DB-Server erforderlich)
DB_CLIENT=sqlite
SQLITE_FILE=./data/lacedaemon.sqlite

# Alternative: DB_CLIENT=postgres und Verbindung unten aktivieren.
# DATABASE_URL=postgresql://postgres:DEIN_PASSWORT@localhost:5432/lacedaemon
